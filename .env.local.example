# Supabase Project Credentials (Found in Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional Service Role Key for Admin Operations (Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL for Auth Redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (Phase 2 profile photo upload — UNSIGNED preset)
# Dashboard → Settings → Upload → Upload presets → create one with Signing Mode = "Unsigned"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-preset-name
